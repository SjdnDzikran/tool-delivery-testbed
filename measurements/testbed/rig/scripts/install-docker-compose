#!/bin/sh
# User-local, checksum-pinned Compose; no sudo or global Docker changes.
set -eu
RIG=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
BIN="$RIG/runtime/bin/docker-compose"
mkdir -p "$RIG/runtime/bin" "$RIG/runtime/docker-client/cli-plugins"
curl --fail --location --retry 2 --max-time 180 \
  https://github.com/docker/compose/releases/download/v5.6.1/docker-compose-linux-x86_64 -o "$BIN"
printf '%s  %s\n' 47737f4236e6d3ccea7291995203f8f018058783b4c3a9469119811a0b5db8c0 "$BIN" | sha256sum --check --status
chmod 755 "$BIN"
ln -sfn ../../bin/docker-compose "$RIG/runtime/docker-client/cli-plugins/docker-compose"
DOCKER_CONFIG="$RIG/runtime/docker-client" docker compose version
